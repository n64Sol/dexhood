# mock | geckoterminal | dexpaprika
DATA_PROVIDER=mock

# Optional. Public GeckoTerminal works without a key but is rate-limited.
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2

# Optional DexPaprika key raises the monthly quota.
DEXPAPRIKA_API_URL=https://api.dexpaprika.com
DEXPAPRIKA_API_KEY=

# Official Robinhood Stock Token REST. No key required.
ROBINHOOD_RHJ_URL=https://api.robinhood.com/rhj
